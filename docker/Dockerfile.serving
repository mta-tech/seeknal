# Atlas Runtime Serving release image (atlas-rt-serving).
#
# Online lock-only build from repository root:
#   docker build -f docker/Dockerfile.serving \
#     --build-arg SEEKNAL_COMMIT=$(git rev-parse HEAD) \
#     -t atlas-rt-serving:local .
#
# Air-gapped (--network=none) build after running prefetch:
#   python3 docker/serving-image/prefetch.py --vendor-dir docker/serving-image/vendor
#   docker build --network=none -f docker/Dockerfile.serving \
#     --build-arg OFFLINE=1 \
#     --build-arg SEEKNAL_COMMIT=$(git rev-parse HEAD) \
#     -t atlas-rt-serving:airgapped .

ARG BASE_IMAGE=ghcr.io/astral-sh/uv:0.9.18-python3.11-bookworm-slim
FROM ${BASE_IMAGE} AS runtime

ARG SEEKNAL_COMMIT=unknown
ARG BUILD_TIME=""
ARG OFFLINE=0
ARG TARGETARCH

LABEL org.opencontainers.image.title="atlas-rt-serving" \
      org.opencontainers.image.source="https://github.com/mta-tech/seeknal" \
      org.opencontainers.image.revision="${SEEKNAL_COMMIT}" \
      io.atlas.runtime.image="atlas-rt-serving"

ENV PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    SEEKNAL_EXTENSION_DIRECTORY=/opt/seeknal/duckdb_extensions

WORKDIR /opt/seeknal

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY docker/serving-requirements.txt ./docker/serving-requirements.txt
COPY docker/serving-image/ ./docker/serving-image/
COPY src/ ./src/

RUN set -eu; \
    mkdir -p docs/cli /opt/seeknal/duckdb_extensions /etc/seeknal; \
    if [ "${OFFLINE}" = "1" ]; then \
        python3 docker/serving-image/prefetch.py verify-vendor \
            --vendor-dir docker/serving-image/vendor \
            --uv-lock uv.lock \
            --extensions-lock docker/serving-image/extensions.lock.json \
            --platform "${TARGETARCH:-}"; \
        uv pip install --system --offline --no-index --require-hashes \
            --find-links docker/serving-image/vendor/wheels \
            -r docker/serving-image/vendor/requirements.txt; \
        uv pip install --system --offline --no-index --no-deps --no-build-isolation .; \
        python3 docker/serving-image/prefetch.py install-extensions \
            --extensions-lock docker/serving-image/extensions.lock.json \
            --extension-directory /opt/seeknal/duckdb_extensions \
            --vendor-extensions-dir docker/serving-image/vendor/extensions \
            --platform "${TARGETARCH:-}" \
            --offline; \
    else \
        uv export --locked --only-group serving --no-emit-project --format requirements-txt -o /tmp/requirements.txt; \
        uv pip install --system --require-hashes -r /tmp/requirements.txt; \
        uv pip install --system --no-deps .; \
        python3 docker/serving-image/prefetch.py install-extensions \
            --extensions-lock docker/serving-image/extensions.lock.json \
            --extension-directory /opt/seeknal/duckdb_extensions \
            --platform "${TARGETARCH:-}"; \
    fi; \
    SEEKNAL_COMMIT="${SEEKNAL_COMMIT}" BUILD_TIME="${BUILD_TIME}" python3 -c \
        'import os; from seeknal.serving.buildinfo import write_build_info; write_build_info("/opt/seeknal/buildinfo.json", git_sha=os.environ.get("SEEKNAL_COMMIT", "unknown"), build_time=os.environ.get("BUILD_TIME") or None, lock_path="uv.lock", source_dir="src/seeknal")'; \
    python3 docker/serving-image/check_serving_env.py \
        --uv-lock uv.lock \
        --extensions-lock docker/serving-image/extensions.lock.json \
        --extension-directory /opt/seeknal/duckdb_extensions \
        --platform "${TARGETARCH:-}"; \
    chmod 755 /etc/seeknal; \
    chmod -R a+rX /opt/seeknal/duckdb_extensions /opt/seeknal/buildinfo.json; \
    rm -rf /root/.cache /tmp/* docs/cli docker/serving-image/vendor

USER 10001:10001

EXPOSE 8765

ENTRYPOINT ["python", "-m", "seeknal.serving"]
CMD ["--config", "/etc/seeknal/serving.yaml"]
